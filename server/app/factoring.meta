{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/factoring/layout,_N_T_/factoring/page,_N_T_/factoring"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/factoring/__PAGE__",
    "/factoring",
    "/_index",
    "/_head"
  ]
}